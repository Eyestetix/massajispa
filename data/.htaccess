# Deny direct browser access to sensitive data files
<Files "bookings.json">
    Require all denied
    Order allow,deny
    Deny from all
</Files>

<Files "analytics.json">
    Require all denied
    Order allow,deny
    Deny from all
</Files>

<Files ~ "\.(lock|bak|log)$">
    Require all denied
    Order allow,deny
    Deny from all
</Files>
